#!/bin/bash
# Start LinguaLocal (http://localhost:8767) at login and keep it running (LaunchAgent local.lingualocal).
#   scripts/install-login            install and start
#   scripts/install-login --remove   stop and remove
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
LABEL="local.lingualocal"
OLD_LABEL="local.pronunciation-mirror"  # the app's first name; replaced on install
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
PY="$(command -v /opt/homebrew/bin/python3 || command -v python3)"
launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
launchctl bootout "gui/$(id -u)/$OLD_LABEL" 2>/dev/null || true
rm -f "$HOME/Library/LaunchAgents/$OLD_LABEL.plist"
if [[ "${1:-}" == "--remove" ]]; then rm -f "$PLIST"; echo "Removed $LABEL"; exit 0; fi
mkdir -p "$HOME/Library/LaunchAgents" "$HOME/Library/Logs"
cat > "$PLIST" <<PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>$PY</string><string>$ROOT/server.py</string></array>
  <key>WorkingDirectory</key><string>$ROOT</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>$HOME/Library/Logs/LinguaLocal.log</string>
  <key>StandardErrorPath</key><string>$HOME/Library/Logs/LinguaLocal.log</string>
</dict></plist>
PL
launchctl bootstrap "gui/$(id -u)" "$PLIST"
echo "Installed $LABEL — open http://localhost:8767"
