# LinguaLocal needs no API keys, passwords or tokens: everything runs on this Mac.
# All settings are optional and read from the environment. Defaults are shown.
# The servers do not load this file by themselves; to use it when starting by hand:
#   set -a; source .env; set +a; python3 server.py

# --- the web app (server.py) ---
LL_PORT=8767
LL_SERVICES=http://localhost:8770
# LL_DATA_DIR="$HOME/Library/Application Support/LinguaLocal"

# --- Language Services (language-services/server.py) ---
LS_PORT=8770
LS_ALLOWED_ORIGINS=http://localhost:8767,http://127.0.0.1:8767
LS_OLLAMA_URL=http://127.0.0.1:11434
LS_OLLAMA_MODEL=gemma3:12b
LS_OLLAMA_KEEP_ALIVE=30m
LS_VOICE_US=af_heart
LS_VOICE_UK=bf_emma
LS_VOICE_TR=Yelda
# LS_DATA_DIR="$HOME/Library/Application Support/Language Services"

# --- MCP server (language-services/mcp_server.py) ---
LS_URL=http://127.0.0.1:8770
